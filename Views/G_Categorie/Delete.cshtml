@model ApplicationDeGestionERP.Models.G_Categorie

@{
    ViewData["Title"] = "Supprimer une Catégorie";
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-danger text-center"><i class="bi bi-trash3"></i> Supprimer la Catégorie</h2>
        <p class="text-muted text-center">Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible.</p>
        <hr />

        <div class="row justify-content-center">
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-4"><i class="bi bi-tag"></i> Nom de la Catégorie :</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NomCategorie)</dd>

                    <dt class="col-sm-4"><i class="bi bi-file-text"></i> Description :</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.DescriptionCategorie)</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="CategorieID" />

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Annuler</a>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Supprimer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
