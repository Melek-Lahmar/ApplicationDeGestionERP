@model IEnumerable<ApplicationDeGestionERP.Models.G_Categorie>

@{
    ViewData["Title"] = "Liste des Catégories";
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container my-4">
    <h1 class="text-primary text-center"><i class="bi bi-list-ul"></i> Liste des Catégories</h1>
    <p class="text-muted text-center">Voici les catégories disponibles dans le système.</p>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-primary" onclick="window.location.href='@Url.Action("Create")'">
                <i class="bi bi-plus-circle"></i> Ajouter une catégorie
            </button>
        </div>
        <form class="d-flex" method="get" action="@Url.Action("Index")">
            <input class="form-control me-2" type="search" name="search" placeholder="Rechercher une catégorie" aria-label="Search">
            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Rechercher</button>
        </form>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nom de la Catégorie</th>
                <th>Description</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NomCategorie</td>
                    <td>@item.DescriptionCategorie</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.CategorieID" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil-square"></i> Modifier
                        </a>
                        <a asp-action="Details" asp-route-id="@item.CategorieID" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-info-circle"></i> Détails
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.CategorieID" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i> Supprimer
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
