@model ApplicationDeGestionERP.Models.G_Categorie

@{
    ViewData["Title"] = "Détails de la Catégorie";
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-primary text-center"><i class="bi bi-folder"></i> Détails de la Catégorie</h2>
        <hr />

        <dl class="row">
            <dt class="col-sm-4"><i class="bi bi-tag"></i> Nom de la Catégorie :</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.NomCategorie)</dd>

            <dt class="col-sm-4"><i class="bi bi-file-text"></i> Description :</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.DescriptionCategorie)</dd>
        </dl>

        <h4 class="text-secondary mt-4"><i class="bi bi-box-seam"></i> Articles dans cette catégorie</h4>
        <hr />

        <div class="row">
            @if (Model.Articles != null && Model.Articles.Any())
            {
                foreach (var article in Model.Articles)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow">
                            <img src="@article.ImageUrl" class="card-img-top" alt="@article.NomArticle" style="height: 200px; object-fit: cover;" />
                            <div class="card-body">
                                <h5 class="card-title text-primary">@article.NomArticle</h5>
                                <p class="card-text text-muted">@article.DescriptionArticle</p>
                                <p class="card-text"><strong>Prix : </strong> @article.PrixDeVente.ToString("N2") TND</p>
                                <a asp-action="Details" asp-controller="G_Article" asp-route-id="@article.ArticleID" class="btn btn-outline-primary"><i class="bi bi-eye"></i> Voir Détails</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning text-center" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> Aucun article associé à cette catégorie.
                </div>
            }
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Retour</a>
            <a asp-action="Edit" asp-route-id="@Model.CategorieID" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Modifier</a>
        </div>
    </div>
</div>
