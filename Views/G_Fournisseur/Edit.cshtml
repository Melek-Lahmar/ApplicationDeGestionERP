@model ApplicationDeGestionERP.Models.G_Fournisseur

@{
    ViewData["Title"] = "Modifier un Fournisseur";
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    Layout = SignInManager.IsSignedIn(User) && User.IsInRole("Admin")
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-primary"><i class="bi bi-pencil-square"></i> Modifier un Fournisseur</h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    </div>

    <div class="card shadow p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="IDFournisseur" />

            <div class="mb-3">
                <label asp-for="NomFournisseur" class="form-label fw-bold"><i class="bi bi-person"></i> Nom du Fournisseur</label>
                <input asp-for="NomFournisseur" class="form-control" placeholder="Entrez le nom du fournisseur">
                <span asp-validation-for="NomFournisseur" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold"><i class="bi bi-card-text"></i> Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ajoutez une description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NumTelephone" class="form-label fw-bold"><i class="bi bi-telephone"></i> Téléphone</label>
                <input asp-for="NumTelephone" class="form-control" placeholder="Entrez le numéro de téléphone">
                <span asp-validation-for="NumTelephone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Adresse" class="form-label fw-bold"><i class="bi bi-geo-alt"></i> Adresse</label>
                <input asp-for="Adresse" class="form-control" placeholder="Entrez l'adresse">
                <span asp-validation-for="Adresse" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <label asp-for="TotalMontantAchete" class="form-label fw-bold"><i class="bi bi-cash-stack"></i> Total Acheté (TND)</label>
                    <input asp-for="TotalMontantAchete" class="form-control text-end">
                    <span asp-validation-for="TotalMontantAchete" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MontantPaye" class="form-label fw-bold"><i class="bi bi-currency-dollar"></i> Montant Payé (TND)</label>
                    <input asp-for="MontantPaye" class="form-control text-end">
                    <span asp-validation-for="MontantPaye" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold"><i class="bi bi-exclamation-circle"></i> Montant Non Payé (TND)</label>
                    <input type="text" class="form-control text-end bg-light" value="@(Model.TotalMontantAchete - Model.MontantPaye) TND" readonly>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Enregistrer</button>
                <a asp-action="Index" class="btn btn-secondary ms-2"><i class="bi bi-x-circle"></i> Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
