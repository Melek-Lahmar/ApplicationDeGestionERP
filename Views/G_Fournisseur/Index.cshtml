@model IEnumerable<ApplicationDeGestionERP.Models.G_Fournisseur>

@{
    ViewData["Title"] = "Liste des Fournisseurs";
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    Layout = SignInManager.IsSignedIn(User) && User.IsInRole("Admin")
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1 class="text-primary"><i class="bi bi-truck"></i> Liste des Fournisseurs</h1>
        <button class="btn btn-success" onclick="window.location.href='@Url.Action("Create")'">
            <i class="bi bi-plus-circle"></i> Ajouter un Fournisseur
        </button>
    </div>
    <p class="text-muted">Consultez et gérez les fournisseurs de votre entreprise.</p>

    <div class="card shadow-sm p-3 mb-4 bg-white rounded">
        <form class="d-flex" method="get" action="@Url.Action("Index")">
            <input class="form-control me-2" type="search" name="search" placeholder="Rechercher un fournisseur..." aria-label="Search">
            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Rechercher</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Téléphone</th>
                    <th>Adresse</th>
                    <th class="text-end">Total Acheté (TND)</th>
                    <th class="text-end">Montant Payé (TND)</th>
                    <th class="text-end">Montant Non Payé (TND)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.NomFournisseur)</td>
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>
                        <td>@Html.DisplayFor(modelItem => item.NumTelephone)</td>
                        <td>@Html.DisplayFor(modelItem => item.Adresse)</td>
                        <td class="text-end fw-bold text-success">@item.TotalMontantAchete.ToString("N2") TND</td>
                        <td class="text-end fw-bold text-primary">@item.MontantPaye.ToString("N2") TND</td>
                        <td class="text-end fw-bold text-danger">@item.MontantNonPaye.ToString("N2") TND</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.IDFournisseur" class="btn btn-sm btn-warning mx-1">
                                <i class="bi bi-pencil-square"></i> Modifier
                            </a>
                            <a asp-action="Details" asp-route-id="@item.IDFournisseur" class="btn btn-sm btn-info mx-1 text-white">
                                <i class="bi bi-info-circle"></i> Détails
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IDFournisseur" class="btn btn-sm btn-danger mx-1">
                                <i class="bi bi-trash"></i> Supprimer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
