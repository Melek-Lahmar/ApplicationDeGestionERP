    <script>
        function addRow() {
            let rowCount = $("#ligne-container tr").length;
            let newRow = `
                <tr>
                    <td>
                        <select class="form-control articleID" onchange="updatePrixUnitaire(this, ${rowCount})">
                            <option value="">-- Sélectionnez un article --</option>
        @foreach (var article in ViewBag.Articles)
        {
                                        <option value="@article.Value">@article.Text</option>
        }
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control quantite" min="1" required oninput="calculateMontant(${rowCount})" />
                    </td>
                    <td>
                        <input type="number" class="form-control prixUnitaire" readonly />
                    </td>
                    <td>
                        <input type="text" class="form-control montantLigne" readonly />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="removeRow(this)">Supprimer</button>
                    </td>
                </tr>`;
            $("#ligne-container").append(newRow);
        }

        function removeRow(button) {
            $(button).closest("tr").remove();
            updateTotalHTandTTC();
        }

        function updatePrixUnitaire(selectElement, index) {
            let articleId = selectElement.value;
            if (!articleId) return;

            fetch(`/G_Facture/GetPrixUnitaire?articleId=${articleId}`)
                .then(response => response.json())
                .then(prixUnitaire => {
                    $(`#ligne-container tr:eq(${index}) .prixUnitaire`).val(prixUnitaire.toFixed(2));
                    calculateMontant(index);
                })
                .catch(error => console.error("Erreur de récupération du prix unitaire :", error));
        }

        function calculateMontant(index) {
            let quantite = $(`#ligne-container tr:eq(${index}) .quantite`).val();
            let prixUnitaire = $(`#ligne-container tr:eq(${index}) .prixUnitaire`).val();
            let montant = (quantite * prixUnitaire).toFixed(2);
            $(`#ligne-container tr:eq(${index}) .montantLigne`).val(montant);
            updateTotalHTandTTC();
        }

        function updateTotalHTandTTC() {
            let totalHT = 0;
            $(".montantLigne").each(function () {
                totalHT += parseFloat($(this).val()) || 0;
            });

            let totalTTC = totalHT+((totalHT*19)/100); // Add VAT logic here if needed
            $("#MontantTotalHT").val(totalHT.toFixed(2));
            $("#MontantTotalTTC").val(totalTTC.toFixed(2));
        }

        $("#factureForm").submit(function (event) {
            event.preventDefault();

            let facture = {
                FactureID: $("#FactureID").val(),
                FactureRef: $("#FactureRef").val(),
                DateFacture: $("#DateFacture").val(),
                ClientID: $("#ClientID").val(),
                LignesFacture: []
            };

            $("#ligne-container tr").each(function () {
                let articleID = $(this).find(".articleID").val();
                let quantite = $(this).find(".quantite").val();
                let prixUnitaire = $(this).find(".prixUnitaire").val();

                if (articleID && quantite && prixUnitaire) {
                    facture.LignesFacture.push({
                        ArticleID: parseInt(articleID),
                        Quantite: parseInt(quantite),
                        PrixUnitaire: parseFloat(prixUnitaire)
                    });
                }
            });

            $.ajax({
                url: '@Url.Action("CreateOrEdit", "G_Facture")',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(facture),
                success: function (response) {
                    if (response.success) {
                        alert("Facture enregistrée avec succès!");
                        window.location.href = "/G_Facture/Index";
                    } else {
                        alert(response.message || "Erreur lors de l'enregistrement.");
                    }
                },
                error: function (xhr, status, error) {
                    alert("Erreur AJAX : " + error);
                }
            });
        });
    </script>
}
