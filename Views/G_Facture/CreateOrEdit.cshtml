@model ApplicationDeGestionERP.Models.G_Facture
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<h2>@(Model.FactureID == 0 ? "Créer une nouvelle facture" : "Modifier la facture")</h2>

<form id="factureForm">
    <input type="hidden" asp-for="FactureID" />

    <!-- Détails de la facture -->
    <div>
        <label asp-for="FactureRef"></label>
        <input asp-for="FactureRef" class="form-control" />
    </div>

    <div>
        <label asp-for="DateFacture"></label>
        <input asp-for="DateFacture" type="date" class="form-control" />
    </div>

    <div>
        <label asp-for="ClientID">Client</label>
        <select asp-for="ClientID" asp-items="ViewBag.Clients" class="form-control">
            <option value="">-- Sélectionnez un client --</option>
        </select>
        <span asp-validation-for="ClientID" class="text-danger"></span>
    </div>

    <!-- Lignes de Facture -->
    <h3>Lignes de Facture</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Article</th>
                <th>Quantité</th>
                <th>Prix Unitaire</th>
                <th>Montant</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="ligne-container">
            @for (int i = 0; i < Model.LignesFacture.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="LignesFacture[@i].ArticleID" asp-items="ViewBag.Articles" class="form-control" onchange="updatePrixUnitaire(this, @i)">
                            <option value="">-- Sélectionnez un article --</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="LignesFacture[@i].Quantite" class="form-control" oninput="calculateMontant(@i)" />
                    </td>
                    <td>
                        <input asp-for="LignesFacture[@i].PrixUnitaire" class="form-control" readonly />
                    </td>
                    <td>
                        <input asp-for="LignesFacture[@i].MontantLigne" class="form-control" readonly />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="removeRow(this)">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Bouton pour ajouter une ligne -->
    <button type="button" class="btn btn-primary" onclick="addRow()">Ajouter une ligne</button>

    <!-- Montant Total HT et TTC -->
    <div>
        <label>Montant Total HT</label>
        <input type="text" class="form-control" id="MontantTotalHT" value="@Model.MontantTotalHT" readonly />
    </div>
    <div>
        <label>Montant Total TTC</label>
        <input type="text" class="form-control" id="MontantTotalTTC" value="@Model.MontantTotalTTC" readonly />
    </div>

    <br />
    <button type="submit" class="btn btn-success">Enregistrer</button>
</form>

