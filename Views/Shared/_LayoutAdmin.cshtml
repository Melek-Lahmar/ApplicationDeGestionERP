<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <title>Admin Dashboard - SB Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link href="~/cssDash/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>

    @* Vous pouvez également définir d'autres fichiers CSS spécifiques à la page ici *@
    @RenderSection("Styles", false)  <!-- Permet d'ajouter des styles spécifiques à la page -->
</head>
<body class="sb-nav-fixed">
    @* Navbar *@
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3" href="index.html">
            <img src="~/images/logo-white.png" alt="Logo de l'application" style="height: 20px; width: 130px;">
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!">
            <i class="fas fa-bars"></i>
        </button>
        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
            <partial name="_LoginPartial" />
        </ul>
    </nav>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Core</div>
                        <a class="nav-link" asp-action="Index" asp-controller="DashBoard">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Interface</div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseLayouts" aria-expanded="false" aria-controls="collapseLayouts">
                            <div class="sb-nav-link-icon"><i class="fas fa-columns"></i></div>
                            Statistiques
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseLayouts" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" href="@Url.Action("Charts", "DashBoard")">
                                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                                    Articles les Plus Vendus
                                </a>
                                <a class="nav-link" href="@Url.Action("tables", "DashBoard")">
                                    <div class="sb-nav-link-icon"><i class="fas fa-table"></i></div>
                                    Clients Par Chiffre
                                </a>
                            </nav>
                        </div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapsePages" aria-expanded="false" aria-controls="collapsePages">
                            <div class="sb-nav-link-icon"><i class="bi bi-people-fill"></i></div>
                            Utilisateurs
                            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>

                        <div class="collapse" id="collapsePages" aria-labelledby="headingTwo" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav accordion" id="sidenavAccordionPages">
                                <a class="nav-link" asp-action="Index" asp-controller="G_Utilisateurs">Liste des utilisateurs</a>
                                <a class="nav-link" asp-action="Create" asp-controller="G_Utilisateurs">Ajouter un utilisateur</a>
                            </nav>
                        </div>
                        @* <div class="sb-sidenav-menu-heading">Addons</div>
                        <a class="nav-link" href="@Url.Action("Charts", "DashBoard")">
                            <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                            Articles les Plus Vendus
                        </a>
                        <a class="nav-link" href="@Url.Action("tables", "DashBoard")">
                            <div class="sb-nav-link-icon"><i class="fas fa-table"></i></div>
                            Clients Par Chiffre
                        </a> *@
                    </div>
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main>
                @RenderBody()  <!-- Contenu principal -->
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="container">
                            &copy; 2025 - ApplicationWebERP  craeated by <strong>Melek Lahmar</strong> @*  <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    @* Scripts communs pour toutes les pages *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/jsDash/scripts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="~/jsDash/datatables-simple-demo.js"></script>

    @* Si des scripts spécifiques sont définis dans la vue, ils seront rendus ici *@
    @RenderSection("Scripts", false)
</body>
</html>
