<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApplicationWebERP</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container-fluid" bis_skin_checked="1">
                <a class="navbar-brand" href="#"><img src="~/images/logo-white.png" alt="Logo de l'application" style="height: 20px; width: 130px;"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor01" bis_skin_checked="1">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                Home
                                <span class="visually-hidden">(current)</span>
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="G_Categorie" asp-action="Index">Categorie</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link"  href="https://www.infosoft.tn/a-propos/contactez-nous/">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Qui Sommes Nous ?</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"  href="https://maps.app.goo.gl/QrDSRAGVbjQf9k4U6">visitez</a>
                        </li>

                       
                       
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <style>
            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh; /* Assurez-vous que le corps prend au moins la hauteur de la fenêtre */
                margin: 0; /* Supprimez les marges par défaut */
            }

            .content {
                flex: 1; /* Permet au contenu de prendre l'espace disponible */
            }
        </style>
        <div class="container">
            &copy; 2025 - ApplicationWebERP  craeated by <strong>Melek Lahmar</strong> @*  <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
