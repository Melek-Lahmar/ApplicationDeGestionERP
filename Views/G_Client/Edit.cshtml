@model ApplicationDeGestionERP.Models.G_Client

@{
    ViewData["Title"] = "Modifier un Client";
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    Layout = SignInManager.IsSignedIn(User) && User.IsInRole("Admin")
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-warning"><i class="bi bi-pencil-square"></i> Modifier le Client</h1>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    </div>

    <div class="card shadow p-4">
        <h4 class="text-primary">Mettez à jour les informations du client</h4>
        <hr />

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="ClientID" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="NomClient" class="form-label fw-bold"><i class="bi bi-person"></i> Nom</label>
                        <input asp-for="NomClient" class="form-control" placeholder="Ex: Dupont" />
                        <span asp-validation-for="NomClient" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PrénomClient" class="form-label fw-bold"><i class="bi bi-person"></i> Prénom</label>
                        <input asp-for="PrénomClient" class="form-control" placeholder="Ex: Jean" />
                        <span asp-validation-for="PrénomClient" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="AdresseClient" class="form-label fw-bold"><i class="bi bi-geo-alt"></i> Adresse</label>
                        <input asp-for="AdresseClient" class="form-control" placeholder="Ex: 12 Rue de Paris" />
                        <span asp-validation-for="AdresseClient" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TelephoneClient" class="form-label fw-bold"><i class="bi bi-telephone"></i> Téléphone</label>
                        <input asp-for="TelephoneClient" class="form-control" placeholder="Ex: +216 98 123 456" />
                        <span asp-validation-for="TelephoneClient" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="TypeClient" class="form-label fw-bold"><i class="bi bi-person-badge"></i> Type de Client</label>
                        <select asp-for="TypeClient" class="form-control" id="TypeClient">
                            <option value="Personne physique">Personne physique</option>
                            <option value="Personne morale">Personne morale</option>
                        </select>
                        <span asp-validation-for="TypeClient" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold" id="labelMatriculeOuCin"><i class="bi bi-file-earmark-text"></i> CIN</label>
                        <input asp-for="MatriculeFiscaleOuCin" class="form-control" placeholder="Ex: 12345678 ou MF123456789" />
                        <span asp-validation-for="MatriculeFiscaleOuCin" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Enregistrer</button>
                <a asp-action="Index" class="btn btn-secondary ms-2"><i class="bi bi-x-circle"></i> Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        window.onload = function () {
            let typeClient = document.getElementById("TypeClient");
            let labelMatriculeOuCin = document.getElementById("labelMatriculeOuCin");

            function updateLabel() {
                labelMatriculeOuCin.textContent = (typeClient.value === "Personne morale")
                    ? "Matricule Fiscale"
                    : "CIN";
            }

            typeClient.addEventListener("change", updateLabel);
            updateLabel(); // Mettre à jour au chargement
        };
    </script>
}
