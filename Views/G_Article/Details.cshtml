@model ApplicationDeGestionERP.Models.G_Article

@{
    ViewData["Title"] = "Détails de l'Article";
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-primary"><i class="bi bi-box-seam me-2"></i> Détails de l'Article</h1>
            <p class="text-secondary">Visualisez les informations complètes de l'article.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm d-flex align-items-center">
            <i class="bi bi-arrow-left-circle me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="card shadow-lg p-4">
        <div class="row">
            <!-- Image -->
            <div class="col-md-5 text-center">
                <img src="@Model.ImageUrl" alt="@Model.NomArticle" class="img-fluid rounded shadow-sm" style="max-width: 100%; height: auto;" />
            </div>

            <!-- Détails -->
            <div class="col-md-7">
                <dl class="row">

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-tag"></i> Référence :</dt>
                    <dd class="col-sm-7">@Model.ReferenceArticle</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-box"></i> Nom :</dt>
                    <dd class="col-sm-7">@Model.NomArticle</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-file-text"></i> Description :</dt>
                    <dd class="col-sm-7">@Model.DescriptionArticle</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-boxes"></i> Stock :</dt>
                    <dd class="col-sm-7">@Model.QteStockArticle</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-cash"></i> Prix d'achat :</dt>
                    <dd class="col-sm-7 text-success fw-bold">@Model.PrixAchat.ToString("N2") TND</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-tags"></i> Prix de vente :</dt>
                    <dd class="col-sm-7 text-danger fw-bold">@Model.PrixDeVente.ToString("N2") TND</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-percent"></i> TVA :</dt>
                    <dd class="col-sm-7">@Model.TVA%</dd>

                    <dt class="col-sm-5 fw-bold"><i class="bi bi-folder"></i> Catégorie :</dt>
                    <dd class="col-sm-7">@Model.Categorie?.NomCategorie</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle me-1"></i> Retour</a>
        <a asp-action="Edit" asp-route-id="@Model?.ArticleID" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i> Modifier</a>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
