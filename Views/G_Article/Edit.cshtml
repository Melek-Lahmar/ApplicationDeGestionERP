@model ApplicationDeGestionERP.Models.G_Article

@{
    ViewData["Title"] = "Modifier un article";
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i> Modifier l'article</h1>
            <p class="text-secondary">Mettez à jour les informations de l'article avec précision.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm d-flex align-items-center">
            <i class="bi bi-arrow-left-circle me-1"></i> Retour à la liste
        </a>
    </div>

    <div class="card shadow-lg p-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form asp-action="Edit" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="ArticleID" />

                    <div class="mb-3">
                        <label asp-for="ReferenceArticle" class="form-label fw-bold"><i class="bi bi-tag"></i> Référence</label>
                        <input asp-for="ReferenceArticle" class="form-control" required />
                        <span asp-validation-for="ReferenceArticle" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NomArticle" class="form-label fw-bold"><i class="bi bi-box"></i> Nom de l'article</label>
                        <input asp-for="NomArticle" class="form-control" required />
                        <span asp-validation-for="NomArticle" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DescriptionArticle" class="form-label fw-bold"><i class="bi bi-file-text"></i> Description</label>
                        <textarea asp-for="DescriptionArticle" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="DescriptionArticle" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="QteStockArticle" class="form-label fw-bold"><i class="bi bi-boxes"></i> Stock</label>
                            <input asp-for="QteStockArticle" type="number" class="form-control" required />
                            <span asp-validation-for="QteStockArticle" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TVA" class="form-label fw-bold"><i class="bi bi-percent"></i> TVA (%)</label>
                            <input asp-for="TVA" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="TVA" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrixAchat" class="form-label fw-bold"><i class="bi bi-cash"></i> Prix d'achat (TND)</label>
                            <input asp-for="PrixAchat" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="PrixAchat" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrixDeVente" class="form-label fw-bold"><i class="bi bi-tags"></i> Prix de vente (TND)</label>
                            <input asp-for="PrixDeVente" type="number" step="0.01" class="form-control" required />
                            <span asp-validation-for="PrixDeVente" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategorieID" class="form-label fw-bold"><i class="bi bi-folder"></i> Catégorie</label>
                        <select asp-for="CategorieID" class="form-select" asp-items="ViewBag.CategorieID"></select>
                        <span asp-validation-for="CategorieID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-bold"><i class="bi bi-image"></i> Image de l'article</label>
                        <input asp-for="ImageUrl" class="form-control" id="imageInput" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-center">
                        <img id="imagePreview" class="rounded shadow-sm" style="max-width: 150px; max-height: 150px; display: none;" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle me-1"></i> Retour</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const imageInput = document.getElementById("imageInput");
        const imagePreview = document.getElementById("imagePreview");

        if (imageInput && imagePreview) {
            imageInput.addEventListener("input", function () {
                const imageUrl = imageInput.value;
                if (imageUrl) {
                    imagePreview.src = imageUrl;
                    imagePreview.style.display = "block";
                } else {
                    imagePreview.style.display = "none";
                }
            });

            // Charger l'image actuelle si déjà définie
            if (imageInput.value) {
                imagePreview.src = imageInput.value;
                imagePreview.style.display = "block";
            }
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
