@model IEnumerable<ApplicationDeGestionERP.Models.G_Article>

@{
    ViewData["Title"] = "Liste des Articles";
}
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-primary">Catalogue des Articles</h1>
            <p class="text-secondary">Gérez facilement les articles de votre stock grâce à cette interface intuitive.</p>
        </div>
        <div>
            <button class="btn btn-primary shadow-sm d-flex align-items-center" onclick="window.location.href='@Url.Action("Create")'">
                <i class="bi bi-plus-circle fs-5 me-2"></i> Ajouter un article
            </button>
        </div>
    </div>

    <form class="d-flex mb-4 shadow-sm p-3 bg-body rounded" method="get" action="@Url.Action("Index")">
        <input class="form-control me-2" type="search" name="search" value="@ViewData["SearchQuery"]" placeholder="Rechercher un article (nom, description, ou prix)" aria-label="Search">
        <button class="btn btn-outline-primary d-flex align-items-center" type="submit">
            <i class="bi bi-search me-1"></i> Rechercher
        </button>
    </form>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped align-middle text-center">
            <thead class="table-primary">
                <tr class="text-nowrap">
                    <th>Image</th>
                    <th>Référence</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Stock</th>
                    <th>Prix d'Achat</th>
                    <th>Prix de Vente</th>
                    <th>TVA</th>
                    <th>Catégorie</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-muted text-center">
                            <em>Aucun article trouvé. Utilisez le bouton "Ajouter un article" pour en créer un.</em>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="Image de l'article" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">Pas d'image</span>
                                }
                            </td>
                            <td>@item.ReferenceArticle</td>
                            <td>@item.NomArticle</td>
                            <td class="text-truncate" style="max-width: 200px;">@item.DescriptionArticle</td>
                            <td>@item.QteStockArticle</td>
                            <td>@($"{item.PrixAchat:N2} TND")</td>
                            <td>@($"{item.PrixDeVente:N2} TND")</td>
                            <td>@item.TVA %</td>
                            <td>@item.Categorie?.NomCategorie</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.ArticleID" class="btn btn-sm btn-warning d-flex align-items-center">
                                        <i class="bi bi-pencil-square me-1"></i> Modifier
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ArticleID" class="btn btn-sm btn-info text-white d-flex align-items-center">
                                        <i class="bi bi-info-circle me-1"></i> Détails
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ArticleID" class="btn btn-sm btn-danger d-flex align-items-center">
                                        <i class="bi bi-trash me-1"></i> Supprimer
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
